# ===== 应用 =====
# 服务端口
PORT=8080

# ===== MySQL（若依主库）=====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
# ⚠️ 不要提交真实密码，本地 .env 填实际值
DB_PASSWORD=your_mysql_password
DB_DATABASE=ry-vue

# ===== Redis（会话/缓存，Docker 容器）=====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
# 生产环境务必换成随机强密钥（可用：openssl rand -base64 48）
JWT_SECRET=your_random_jwt_secret
# JWT 过期时间（与 Redis 会话 TTL 1800s 保持一致）
JWT_EXPIRES_IN=30m
