# ===== 应用 =====
# 用 8080（若依后端默认端口，避开 project-name 占用的 3000）
PORT=8080

# ===== MySQL（若依主库）=====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=ry-vue

# ===== Redis（会话/缓存，Docker 容器）=====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
JWT_SECRET=ruoyi-nest-jwt-secret-key
# JWT 过期时间（与 Redis 会话 TTL 1800s 保持一致，避免"JWT 先过期但会话还在"的不一致）
JWT_EXPIRES_IN=30m
